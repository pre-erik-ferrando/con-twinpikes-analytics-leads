# Copy to .env (gitignored) and fill in. leadgen.py loads it; an exported variable wins.
DBT_CH_HOST=
DBT_CH_PORT=8123
DBT_CH_USER=
DBT_CH_PASSWORD=
DBT_CH_SCHEMA=fld_landinglgn        # the LANDING database, NOT a layer
APIFY_TOKEN=
OPENAI_API_KEY=                     # llm_provider OPENAI (the default seed)
ANTHROPIC_API_KEY=                  # only with llm_provider ANTHROPIC
LEADGEN_USER=                       # who launches (default: the OS user)
